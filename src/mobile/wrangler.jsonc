{
  "name": "suflyor-mobile",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // SONIOX_API_KEY and ACCESS_CODE are secrets. Set them with `wrangler secret put`, never in this file.
  "assets": {
    "directory": "../../out/mobile",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true
}
