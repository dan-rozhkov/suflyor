{
  "name": "suflyor",
  "version": "0.1.0",
  "private": true,
  "description": "Suflyor: live EN to RU translation and reply hints",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:helper && electron-vite dev",
    "build": "npm run build:helper && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:helper": "mkdir -p resources/bin && swiftc -O -target arm64-apple-macos13.0 -swift-version 5 native/suflyor-audio.swift -o resources/bin/suflyor-audio"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "motion": "^14.9.1",
    "ws": "^8.22.1"
  }
}
