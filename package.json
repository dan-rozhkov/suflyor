{
  "name": "suflyor",
  "version": "0.1.0",
  "private": true,
  "description": "Suflyor: live EN to RU translation in the browser",
  "scripts": {
    "dev": "npm run build && npx wrangler@4 dev",
    "build": "vite build",
    "splash": "node scripts/generate-splash.mjs",
    "deploy": "npm run build && npx wrangler@4 deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0"
  }
}
